{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "network-inventory/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "lab_title", "lab_id", "collected_at", "source_agent",
    "status", "headline", "next_action", "coverage", "devices", "links",
    "services", "keys"
  ],
  "properties": {
    "schema": { "const": "network-inventory/v1" },
    "lab_title": { "type": "string", "minLength": 1 },
    "lab_id": { "type": "string" },
    "collected_at": { "type": "string" },
    "source_agent": { "const": "network-discovery" },
    "status": { "enum": ["complete", "partial", "unavailable"] },
    "headline": { "type": "string" },
    "next_action": { "type": "string" },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "devices", "links", "forwarded", "interfaces", "interfaces_with_address"],
      "properties": {
        "state": { "enum": ["complete", "partial", "unavailable"] },
        "devices": { "type": "integer", "minimum": 0 },
        "links": { "type": "integer", "minimum": 0 },
        "forwarded": { "type": "integer", "minimum": 0 },
        "interfaces": { "type": "integer", "minimum": 0 },
        "interfaces_with_address": { "type": "integer", "minimum": 0 },
        "unresolved_links": { "type": "integer", "minimum": 0 }
      }
    },
    "devices": {
      "type": "array",
      "items": { "$ref": "#/$defs/device" }
    },
    "links": {
      "type": "array",
      "items": { "$ref": "#/$defs/link" }
    },
    "services": { "type": "array" },
    "keys": {
      "type": "array",
      "items": { "type": "string", "pattern": "^(device|interface|site|service|test|control|incident|change|application):[^ ].*$" }
    }
  },
  "$defs": {
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port", "internal_port"],
      "properties": {
        "port": { "type": "integer" },
        "internal_port": { "type": "integer" }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "node_definition", "platform", "state", "group", "tags", "agent_access", "access", "forwarded", "interfaces", "keys"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "node_definition": { "type": "string" },
        "platform": { "type": "string" },
        "state": { "type": ["string", "null"] },
        "group": { "type": ["string", "null"] },
        "tags": { "type": "array", "items": { "type": "string" } },
        "agent_access": { "type": "boolean" },
        "access": {
          "type": "object",
          "additionalProperties": false,
          "required": ["restconf", "ssh"],
          "properties": {
            "restconf": { "oneOf": [{ "$ref": "#/$defs/port" }, { "type": "null" }] },
            "ssh": { "oneOf": [{ "$ref": "#/$defs/port" }, { "type": "null" }] }
          }
        },
        "forwarded": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["external_port", "internal_port"],
            "properties": {
              "external_port": { "type": "integer" },
              "internal_port": { "type": "integer" }
            }
          }
        },
        "interfaces": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "cidr"],
            "properties": {
              "name": { "type": "string" },
              "cidr": { "type": ["string", "null"] }
            }
          }
        },
        "keys": {
          "type": "array",
          "items": { "type": "string", "pattern": "^(device|interface):[^ ].*$" }
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["a_device", "a_interface", "b_device", "b_interface"],
      "properties": {
        "a_device": { "type": "string" },
        "a_interface": { "type": "string" },
        "b_device": { "type": "string" },
        "b_interface": { "type": "string" }
      }
    }
  }
}
