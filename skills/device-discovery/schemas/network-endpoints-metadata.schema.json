{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "network-endpoints-metadata/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "lab_title", "source_agent", "last_visit_id",
    "last_collected_at", "coverage", "visits", "keys"
  ],
  "properties": {
    "schema": { "const": "network-endpoints-metadata/v1" },
    "lab_title": { "type": "string" },
    "source_agent": { "const": "device-discovery" },
    "last_visit_id": { "type": ["string", "null"] },
    "last_collected_at": { "type": "string" },
    "coverage": { "type": "object" },
    "visits": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["watch_id", "checked_at", "status", "delta", "stamp_written"],
        "properties": {
          "watch_id": { "type": ["string", "null"] },
          "checked_at": { "type": "string" },
          "status": { "type": "string" },
          "delta": { "type": "integer", "minimum": 0 },
          "stamp_written": { "type": "boolean" }
        }
      }
    },
    "keys": {
      "type": "array",
      "items": { "type": "string", "pattern": "^(device|interface|site|service|test|control|incident|change|application):[^ ].*$" }
    }
  }
}
